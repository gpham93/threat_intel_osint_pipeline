@prefix bfo: <http://purl.obolibrary.org/obo/> .
@prefix cco: <http://www.ontologyrepository.com/CommonCoreOntologies/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix threat: <http://example.org/threat#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/threat> a owl:Ontology ;
    rdfs:label "Threat Network Ontology" ;
    rdfs:comment "Strict OWL2 Ontology representing a threat intelligence network importing BFO and CCO namespaces." ;
    owl:imports bfo:bfo.owl, cco:UpperOntology .

# Threat Actors
threat:Actor_VictorBout a threat:ThreatActor ;
    rdfs:label "Victor Bout" ;
    threat:aliasName "Merchant of Death" ;
    cco:has_clearance_level "SECRET" ;
    threat:associatedWith threat:FrontCompany_AeroVanguard,
        threat:FrontCompany_TitanMaritime,
        threat:FrontCompany_ZephyrShipping .

threat:Actor_ElenaRostova a threat:ThreatActor ;
    rdfs:label "Elena Rostova" ;
    threat:aliasName "Operator Red" ;
    cco:has_clearance_level "TOP SECRET" ;
    threat:associatedWith threat:FrontCompany_HeliosEnergy,
        threat:FrontCompany_NexusGlobal .

threat:Actor_DmitryVolkov a threat:ThreatActor ;
    rdfs:label "Dmitry Volkov" ;
    threat:aliasName "Viper" ;
    cco:has_clearance_level "SECRET" ;
    threat:associatedWith threat:FrontCompany_Caspian .

threat:Actor_AlexanderPetrov a threat:ThreatActor ;
    rdfs:label "Alexander Petrov" ;
    threat:aliasName "Ghost" ;
    cco:has_clearance_level "UNCLASSIFIED" ;
    threat:associatedWith threat:FrontCompany_GlobalApex,
        threat:FrontCompany_KryptonMaritime .

# Front Companies & Shell Organizations
threat:FrontCompany_AeroVanguard a threat:FrontCompany ;
    rdfs:label "AeroVanguard Logistics Ltd" ;
    threat:sanctionID "OFAC-2026-8812" ;
    threat:jurisdiction "Panama" ;
    threat:swiftBIC "AVLOGPA22" ;
    rdfs:comment "Panamanian logistics front used for illicit weapons cargo and sanction evasion." .

threat:FrontCompany_HeliosEnergy a threat:FrontCompany ;
    rdfs:label "Helios Energy Trading Corp" ;
    threat:sanctionID "OFAC-2026-9941" ;
    threat:jurisdiction "Cyprus" ;
    threat:swiftBIC "HELIOCY22" ;
    rdfs:comment "Cyprus-registered energy broker laundering illicit commodities revenue." .

threat:FrontCompany_Caspian a threat:FrontCompany ;
    rdfs:label "Caspian Merchant Fleet Co" ;
    threat:sanctionID "OFAC-2026-4410" ;
    threat:jurisdiction "UAE" ;
    threat:swiftBIC "CASPDXB44" ;
    rdfs:comment "Maritime maritime transport network operating out of Dubai / JAFZA." .

threat:FrontCompany_TitanMaritime a threat:FrontCompany ;
    rdfs:label "Titan Maritime Holdings" ;
    threat:sanctionID "OFAC-2026-3091" ;
    threat:jurisdiction "Panama" ;
    threat:swiftBIC "TITANPA99" ;
    rdfs:comment "Primary offshore financing vehicle registered in Panama." .

threat:FrontCompany_ZephyrShipping a threat:FrontCompany ;
    rdfs:label "Zephyr Maritime Shipping Corp" ;
    threat:sanctionID "OFAC-2026-4491" ;
    threat:jurisdiction "Marshall Islands" ;
    threat:swiftBIC "ZEPYMH11" ;
    rdfs:comment "Shell fleet provider operating under flags of convenience." .

threat:FrontCompany_NexusGlobal a threat:FrontCompany ;
    rdfs:label "Nexus Global Holdings Corp" ;
    threat:sanctionID "OFAC-2026-9912" ;
    threat:jurisdiction "Panama" ;
    threat:swiftBIC "NEXGPA55" ;
    rdfs:comment "Panamanian asset holding firm linked to Elena Rostova." .

threat:FrontCompany_GlobalApex a threat:FrontCompany ;
    rdfs:label "Apex Cyber Solutions" ;
    threat:sanctionID "OFAC-2026-7782" ;
    threat:jurisdiction "Estonia" ;
    threat:swiftBIC "APEXEE21" ;
    rdfs:comment "Cyber procurement shell firm facilitating dark web infrastructure." .

threat:FrontCompany_KryptonMaritime a threat:FrontCompany ;
    rdfs:label "Krypton Maritime Operations Ltd" ;
    threat:sanctionID "OFAC-2026-9910" ;
    threat:jurisdiction "Cayman Islands" ;
    threat:swiftBIC "KRYPKY88" ;
    rdfs:comment "Offshore trust and maritime leasing company in George Town." .

# Money Transfers & Financial Routing
threat:Transfer_9901 a threat:MoneyTransfer ;
    rdfs:label "Wire Transfer $1.5M (AeroVanguard -> Helios Energy)" ;
    threat:hasAmount 1500000.0 ;
    threat:hasCurrency "USD" ;
    threat:has_sender threat:FrontCompany_AeroVanguard ;
    threat:has_receiver threat:FrontCompany_HeliosEnergy ;
    rdfs:comment "Sanctioned payment for illicit logistics forwarding in Cyprus." .

threat:Transfer_9902 a threat:MoneyTransfer ;
    rdfs:label "Wire Transfer $850K (Helios Energy -> Caspian Fleet)" ;
    threat:hasAmount 850000.0 ;
    threat:hasCurrency "USD" ;
    threat:has_sender threat:FrontCompany_HeliosEnergy ;
    threat:has_receiver threat:FrontCompany_Caspian ;
    rdfs:comment "Bunkering and maritime transport settlement in UAE." .

threat:Transfer_9903 a threat:MoneyTransfer ;
    rdfs:label "Wire Transfer $3.2M (Titan Maritime -> AeroVanguard)" ;
    threat:hasAmount 3200000.0 ;
    threat:hasCurrency "USD" ;
    threat:has_sender threat:FrontCompany_TitanMaritime ;
    threat:has_receiver threat:FrontCompany_AeroVanguard ;
    rdfs:comment "Offshore liquidity injection into Panamanian operations." .

threat:Transfer_9904 a threat:MoneyTransfer ;
    rdfs:label "Wire Transfer $1.1M (Caspian Fleet -> Apex Cyber)" ;
    threat:hasAmount 1100000.0 ;
    threat:hasCurrency "USD" ;
    threat:has_sender threat:FrontCompany_Caspian ;
    threat:has_receiver threat:FrontCompany_GlobalApex ;
    rdfs:comment "Cyber surveillance hardware procurement in Tallinn, Estonia." .

threat:Transfer_9905 a threat:MoneyTransfer ;
    rdfs:label "Wire Transfer $2.4M (Nexus Global -> Titan Maritime)" ;
    threat:hasAmount 2400000.0 ;
    threat:hasCurrency "USD" ;
    threat:has_sender threat:FrontCompany_NexusGlobal ;
    threat:has_receiver threat:FrontCompany_TitanMaritime ;
    rdfs:comment "Inter-entity holding transfer between Panama shell entities." .

# Schema Properties & Upper Ontology Mappings
threat:ThreatActor a owl:Class ;
    rdfs:label "Threat Actor" ;
    rdfs:subClassOf cco:Person .

threat:FrontCompany a owl:Class ;
    rdfs:label "Front Company" ;
    rdfs:subClassOf cco:Organization .

threat:MoneyTransfer a owl:Class ;
    rdfs:label "Money Transfer" ;
    rdfs:subClassOf cco:ActOfCommerce .

threat:aliasName a owl:DatatypeProperty ;
    rdfs:label "alias name" ;
    rdfs:domain cco:Person ;
    rdfs:range xsd:string .

threat:sanctionID a owl:DatatypeProperty ;
    rdfs:label "sanction identifier" ;
    rdfs:domain cco:Organization ;
    rdfs:range xsd:string .

threat:jurisdiction a owl:DatatypeProperty ;
    rdfs:label "jurisdiction" ;
    rdfs:domain cco:Organization ;
    rdfs:range xsd:string .

threat:swiftBIC a owl:DatatypeProperty ;
    rdfs:label "SWIFT BIC" ;
    rdfs:domain cco:Organization ;
    rdfs:range xsd:string .

threat:associatedWith a owl:ObjectProperty ;
    rdfs:label "associated with" ;
    rdfs:domain threat:ThreatActor ;
    rdfs:range threat:FrontCompany .

threat:hasAmount a owl:DatatypeProperty ;
    rdfs:label "has amount" ;
    rdfs:domain threat:MoneyTransfer ;
    rdfs:range xsd:decimal .

threat:hasCurrency a owl:DatatypeProperty ;
    rdfs:label "has currency" ;
    rdfs:domain threat:MoneyTransfer ;
    rdfs:range xsd:string .

threat:has_sender a owl:ObjectProperty ;
    rdfs:label "has sender" ;
    rdfs:domain threat:MoneyTransfer ;
    rdfs:range threat:FrontCompany .

threat:has_receiver a owl:ObjectProperty ;
    rdfs:label "has receiver" ;
    rdfs:domain threat:MoneyTransfer ;
    rdfs:range threat:FrontCompany .
